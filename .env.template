# Copy to .env and fill in for local dev only.
# In production, all secrets come from the KMS — never from this file.

# Required, the server refuses to start without it (docs/LOCAL_SETUP.md#profiles):
#   local  Anvil only (chain 31337), Anvil keys, the dev refund-signer key, the
#          dstack simulator and relaxed rate limits. The placeholders below are
#          only accepted here.
#   prod   never chain 31337, every key derived in the enclave,
#          ETHEREUM_RPC_URLS and ZK_CONTRACT_ADDRESS required, no placeholder.
PROFILE=local
NODE_ENV=development
KMS_URL=https://your-kms.example.com/release

# Keys are derived from the dstack KMS (docs/KEY_DERIVATION.md). To derive
# them locally, run the dstack simulator and point at its socket or URL.
# PROFILE=prod refuses it: the simulator's root key is public.
#DSTACK_SIMULATOR_ENDPOINT=

# Development-only fallbacks when dstack is unavailable. Production refuses
# to start with ADMIN_MLKEM_PRIVATE_KEY or OPERATOR_PRIVATE_KEY set.
# Generate the ML-KEM pair with: pnpm ts-node scripts/testing/generate-admin-keypair.ts
#ADMIN_MLKEM_PUBLIC_KEY=
#ADMIN_MLKEM_PRIVATE_KEY=
#OPERATOR_PRIVATE_KEY=

# Claude API Key (optional - uses mock responses if not set)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ZK Contract Configuration
# Anvil's first deployment address, a placeholder PROFILE=prod refuses
ZK_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Circuit used to verify requests: api_request, api_request_local or api_credit_proof_test
# Defaults to api_request in production (the only one allowed there), api_request_local otherwise
#ZK_CIRCUIT=

# RPC Configuration
# PROFILE=local reads only ANVIL_RPC_URL, and refuses a chain other than 31337:
ANVIL_RPC_URL=http://127.0.0.1:8545
# PROFILE=prod reads only ETHEREUM_RPC_URLS (comma-separated, one is picked at
# random), and refuses chain 31337:
#ETHEREUM_RPC_URLS=https://eth.drpc.org,https://rpc.mevblocker.io/fullprivacy,https://rpc.mevblocker.io/noreverts,https://rpc.mevblocker.io/fast,https://rpc.mevblocker.io,https://rpc.flashbots.net/fast,https://rpc.flashbots.net,https://mainnet.gateway.tenderly.co,https://ethereum-rpc.publicnode.com

# Anvil default account #0, signs contract transactions with PROFILE=local.
# PROFILE=prod refuses it and signs with the enclave-derived identity key.
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Concurrency caps ---
# Work over a cap is refused with 503 instead of queued.
# Proof verifications in flight (RPC round-trip + Groth16 pairing check):
#MAX_CONCURRENT_VERIFICATIONS=8
# Proofs generated in flight for POST /longjing/proofs/slashing:
#MAX_CONCURRENT_PROOFS=2

# --- In-enclave TLS termination (production) ---
# In production, TLS terminates INSIDE the TEE. The key is derived in-enclave
# via the dstack KMS by default; the options below are only for non-dstack
# TEE platforms or explicit (unsafe) opt-out.
#
# Operator-provisioned key material — files MUST live in enclave-only storage.
# Production refuses them unless docker-compose.yml sets the literal
# ALLOW_KEYS_OUTSIDE_ENCLAVE=true (see docs/KEY_DERIVATION.md):
#TLS_KEY_PATH=
#TLS_CERT_PATH=
# Certificate subject / SANs for the dstack-derived certificate:
#TLS_CERT_SUBJECT=longjing
#TLS_CERT_ALT_NAMES=your-domain.example.com
# UNSAFE escape hatch: serve plain HTTP behind an external TLS terminator.
# Request bodies (including secretKey on /longjing/proofs/*) become visible in
# plaintext at the proxy, outside the TEE trust boundary. Never use with real
# user secrets.
#ALLOW_EXTERNAL_TLS_TERMINATION=false